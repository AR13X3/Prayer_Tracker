# Copy this file to `keystore.properties` (repo root of android/) and fill in real values.
# keystore.properties is gitignored — it and the keystore file itself must NEVER be committed.
#
# storeFile: path to your release .jks/.keystore file. Can be absolute
# (e.g. C:/Users/you/keystores/prayertracker-release.jks) or relative to this
# android/ directory — either works with rootProject.file() in app/build.gradle.kts.
#
# Without this file present, `release` builds are simply unsigned (fine for CI-less local
# compiles); Android Studio's own "Generate Signed App Bundle / APK" wizard still works
# independently of this file if you prefer that flow for one-off local builds.

storeFile=C:/path/to/your/release.jks
storePassword=your-store-password
keyAlias=key0
keyPassword=your-key-password
