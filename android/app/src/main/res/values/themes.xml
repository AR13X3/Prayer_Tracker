<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app/activity theme. Actual colors come from Compose (Material 3) at runtime;
         this only needs to be a no-action-bar theme for the Activity to inflate against.
         The warm window background stops the white flash between splash and first frame. -->
    <style name="Theme.PrayerTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_warm</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launch theme. core-splashscreen backports the Android 12 splash to API 26+, so a
         single definition covers every supported version. MainActivity swaps to
         postSplashScreenTheme via installSplashScreen(). -->
    <style name="Theme.PrayerTracker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_warm</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.PrayerTracker</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
