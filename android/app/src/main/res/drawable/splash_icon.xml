<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash / in-app loading mark: the launcher glyph recoloured for the warm background it
  sits on (ink arch, coral crescent) instead of the coral tile it sits on in the launcher.

  Same 108 viewport and same inner-2/3 safe zone the Android 12 splash uses for its icon
  mask, so it lands correctly on both the platform splash and the compat splash.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M37,77.5 L37,50 C37,39.4 44.6,30.5 54,30.5 C63.4,30.5 71,39.4 71,50 L71,77.5"
        android:strokeColor="@color/brand_ink"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M59.75,39.5 A10.5,10.5 0 1 0 59.75,60.5 A12.5,12.5 0 0 1 59.75,39.5 Z"
        android:fillColor="@color/brand_coral" />
</vector>
